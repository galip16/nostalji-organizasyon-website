# Sitenin yayınlandığı adres (alan adı alınca burayı güncelleyin, sonunda / olmasın)
NEXT_PUBLIC_SITE_URL=https://nostalji-organizasyon-website.vercel.app

# --- Admin paneli ---
# Panele giriş şifresi (uzun ve tahmin edilemez bir şifre seçin)
ADMIN_PASSWORD=
# Oturum çerezini imzalamak için rastgele uzun bir metin (en az 32 karakter)
# Üretmek için: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Vercel > Storage > Blob (PUBLIC store) oluşturunca otomatik eklenir
BLOB_READ_WRITE_TOKEN=
